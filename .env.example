# Google Gemini API Keys (Get yours at https://aistudio.google.com/)
# Single key:
GEMINI_API_KEY=your_gemini_api_key_here

# OR Multiple backup keys (comma-separated for automatic failover & high-availability):
# GEMINI_API_KEYS=key_1,key_2,key_3

# Gemini Primary Model
GEMINI_MODEL=gemini-2.5-flash
# Optional TTS Model
GEMINI_TTS_MODEL=
